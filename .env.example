# Copy to .env and tweak for experiments.
CLIENT_ORIGIN=http://localhost:8080
EXTRA_CLIENT_ORIGIN=http://localhost:8081
CURSOR_SECRET=taxi-lab-cursor-secret
FAULTS=0
FEATURE_TARIFFS_V2=0
ACCEPT_DEADLINE_MINUTES=2
POLL_INTERVAL_MS=200
WORKER_RETRIES=3

# External simulator: short delays make the defence fast; production-like values are 2000-8000.
SIM_MIN_DELAY_MS=200
SIM_MAX_DELAY_MS=800
SIM_FAIL_RATE=0.10
SIM_DECLINE_RATE=0.10
SIM_SEED=taxi-seed
